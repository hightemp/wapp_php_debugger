{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hightemp/wapp_php_debugger/spec/logformat/v1/message.schema.json",
  "title": "v1 message line",
  "description": "Every line after the header. sMessage comes from __d() as is, so any scalar is allowed; objects and arrays are not (no viewer can display them).",
  "type": "object",
  "required": ["sType", "sMessage", "iTimestamp"],
  "properties": {
    "sType": {
      "type": "string",
      "minLength": 1,
      "description": "Usually error, warning, info, message or functions_debug, but __d() accepts any string"
    },
    "sMessage": { "type": ["string", "number", "boolean", "null"] },
    "oVars": {
      "type": "object",
      "description": "Variables; the library casts them to an object, so lists arrive as {\"0\": ...}"
    },
    "oBackTrace": {
      "type": "object",
      "description": "Where __d() was called",
      "properties": {
        "file": { "type": ["string", "null"], "description": "Path without DA_ROOT_DIR" },
        "line": { "type": ["integer", "null"] },
        "function": { "type": ["string", "null"] }
      }
    },
    "aBackTrace": {
      "type": "array",
      "items": { "$ref": "#/$defs/frame" }
    },
    "iTimestamp": { "type": "integer", "description": "Write time, ms since the epoch" }
  },
  "$defs": {
    "frame": {
      "type": "object",
      "description": "A debug_backtrace(DEBUG_BACKTRACE_IGNORE_ARGS) frame",
      "properties": {
        "file": { "type": "string" },
        "line": { "type": "integer" },
        "function": { "type": "string" },
        "class": { "type": "string" },
        "type": { "type": "string", "enum": ["->", "::"] }
      }
    }
  }
}
