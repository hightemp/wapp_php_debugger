{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hightemp/wapp_php_debugger/spec/logformat/v1/header.schema.json",
  "title": "v1 log file header",
  "description": "The first line of the file: JSON padded with spaces to 1000 bytes and rewritten in place. Only fields present in the shortened header of the hotfix version are required; unknown fields are allowed (library versions differ).",
  "type": "object",
  "required": ["iRequestTimestamp", "bFinished"],
  "properties": {
    "sURL": { "type": "string", "description": "Request URL, empty for CLI" },
    "sIP": { "type": "string" },
    "sServerIP": { "type": "string" },
    "sServerName": { "type": "string" },
    "bIsCli": { "type": "boolean" },
    "bIsAjax": { "type": "boolean" },
    "aArgv": { "type": "array", "items": { "type": "string" } },
    "sUser": { "type": "string", "description": "PHP process user" },
    "sSysUser": { "type": "string", "description": "Application user" },
    "sSession": { "type": "string" },
    "iRequestTimestamp": { "type": "integer", "description": "Request start, ms since the epoch; equals the file name" },
    "sLang": { "type": "string", "description": "php or js" },
    "bFinished": { "type": "boolean", "description": "false means the request never reached shutdown (the process was killed or is still running)" },
    "iCode": { "type": "integer", "description": "HTTP response code, 0 for CLI" },
    "iStartTime": { "type": "integer" },
    "iStopTime": { "type": "integer" },
    "iTotalTime": { "type": "integer" }
  }
}
