{
    "name": "hightemp/wapp-php-debugger",
    "description": "Debugger library of wapp_php_debugger: writes the events of every request into JSONL logs for the viewer",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "WappDebugger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WappDebugger\\Dev\\": "tools/src/",
            "WappDebugger\\Tests\\": "tests/"
        }
    },
    "bin": [],
    "config": {
        "sort-packages": true,
        "platform-check": false
    },
    "scripts": {
        "test": "phpunit",
        "lint": [
            "php-cs-fixer check --diff",
            "phpstan analyse --no-progress",
            "@naming"
        ],
        "naming": "php tools/bin/check-naming src tests tools"
    }
}
