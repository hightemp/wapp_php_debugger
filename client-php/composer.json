{
    "name": "hightemp/wapp-php-debugger",
    "description": "Debugger library of wapp_php_debugger: writes the events of every request into JSONL logs for the viewer",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=7.4",
        "ext-json": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "monolog/monolog": "^2.9 || ^3.0",
        "opis/json-schema": "^2.3",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^9.6",
        "psr/log": "^1.1 || ^2.0 || ^3.0"
    },
    "autoload": {
        "psr-4": {
            "WappDebugger\\": "src/"
        },
        "files": [
            "src/functions.php"
        ],
        "exclude-from-classmap": [
            "src/autoload.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "WappDebugger\\Dev\\": "tools/src/",
            "WappDebugger\\Tests\\": "tests/"
        }
    },
    "bin": [],
    "config": {
        "sort-packages": true,
        "platform-check": false
    },
    "scripts": {
        "test": "phpunit",
        "lint": [
            "php-cs-fixer check --diff",
            "phpstan analyse --no-progress",
            "@naming"
        ],
        "naming": "php tools/bin/check-naming src tests tools"
    },
    "suggest": {
        "psr/log": "to use WappDebugger\\Bridge\\PsrLogger as a PSR-3 logger",
        "monolog/monolog": "to send Monolog records to the viewer with WappDebugger\\Bridge\\MonologHandler"
    }
}
