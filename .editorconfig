root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,ts,svelte,json,yml,yaml,css,html}]
indent_size = 2

[{*.go,Makefile,go.mod}]
indent_style = tab

[*.log]
# Log fixtures are stored byte for byte
insert_final_newline = false
trim_trailing_whitespace = false

[legacy/**]
# Legacy code is not reformatted
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false
insert_final_newline = false
